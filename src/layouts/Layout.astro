---
import "../styles/global.css";
// The site declares its own @font-face rules rather than importing
// fontsource's stylesheets, which hard-code `font-display: swap`. With `swap`
// a font that misses first paint replaces the fallback text later and the page
// re-wraps under the reader. With `optional` the browser uses the web font if
// it is ready in time and otherwise keeps the fallback for that page view and
// never swaps, so there is nothing to shift. The two faces that carry the
// first screen are preloaded, so on almost every visit the font is ready.
//
// Only the latin subset is declared: nothing on the site uses a character
// outside it (checked over the built pages).
import lora400 from "@fontsource/lora/files/lora-latin-400-normal.woff2?url";
import lora400italic from "@fontsource/lora/files/lora-latin-400-italic.woff2?url";
import lora500 from "@fontsource/lora/files/lora-latin-500-normal.woff2?url";
import sans400 from "@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url";
import sans500 from "@fontsource/source-sans-3/files/source-sans-3-latin-500-normal.woff2?url";
import sans600 from "@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url";
import Divider from "../components/Divider.astro";

const LATIN_SUBSET =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";

const face = (family: string, weight: number, style: string, url: string) =>
  `@font-face{font-family:"${family}";font-style:${style};font-weight:${weight};font-display:optional;` +
  `src:url(${url}) format("woff2");unicode-range:${LATIN_SUBSET}}`;

const fontFaces = [
  face("Source Sans 3", 400, "normal", sans400),
  face("Source Sans 3", 500, "normal", sans500),
  face("Source Sans 3", 600, "normal", sans600),
  face("Lora", 400, "normal", lora400),
  face("Lora", 400, "italic", lora400italic),
  face("Lora", 500, "normal", lora500),
].join("");

interface Props {
  title: string;
  description: string;
  /** Pages that place the divider themselves (the home page) pass false. */
  divider?: boolean;
  /** The 404 page passes true: it is served at many addresses, so it gets noindex and no canonical. */
  noindex?: boolean;
}

const { title, description, divider = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const articlePaths = [
  "/what-is-glycemic-load/",
  "/why-brown-bread-is-still-sugar/",
  "/how-much-sugar-is-in-your-blood/",
];

const nav = [
  { href: "/", label: "Calculator" },
  { href: "/foods/", label: "Foods" },
  { href: "/articles/", label: "Articles" },
  { href: "/sources/", label: "Sources" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const isActive = (href: string) => {
  if (href === "/") return path === "/";
  if (href === "/articles/") return path.startsWith("/articles/") || articlePaths.includes(path);
  return path.startsWith(href);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" as="font" type="font/woff2" href={lora500} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={sans400} crossorigin="anonymous" />
    <style is:inline set:html={fontFaces}></style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#FFFFFF" />
    {
      /* AdSense must not load on the 404 page, which is the only page that passes noindex. */
      !noindex && (
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5806594895991752"
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-paper focus:px-4 focus:py-3 focus:text-ink"
      >Skip to content</a
    >
    <header class="bg-paper border-b border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-2 sm:px-6">
        <a href="/" class="inline-flex min-h-[44px] items-center gap-2 font-serif text-xl text-ink" aria-label="carbs are sugar, home">
          <span class="cube-mark" aria-hidden="true"><span class="cube"></span></span>
          <span>carbs are <span class="text-green">sugar</span></span>
        </a>
        <nav aria-label="Main">
          <ul class="flex flex-wrap items-center gap-x-1 -mx-2">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "inline-flex min-h-[44px] items-center px-2 text-[0.95rem] font-medium",
                      isActive(item.href) ? "text-green" : "text-body hover:text-ink",
                    ]}
                    aria-current={isActive(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      {divider && <slot name="intro" />}
      {divider && <Divider />}
      <slot />
    </main>

    <footer class="bg-ink text-[#D9D4CC]">
      <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
        <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
          <div class="max-w-prose">
            <p class="font-serif text-lg text-paper">carbs are sugar</p>
            <p class="mt-3 text-sm leading-relaxed">
              Food values are Dr David Unwin's teaspoon-of-sugar equivalents, from the sugar infographics published by
              the Public Health Collaboration at
              <a class="text-coral-soft underline underline-offset-2" href="https://phcuk.org/sugar">phcuk.org/sugar</a> and
              used with PHC's permission, and from Unwin, Haslam and Livesey, Journal of Insulin Resistance, 2016.
              Attribution and licence details are on the
              <a class="text-coral-soft underline underline-offset-2" href="/sources/">sources page</a>.
            </p>
            <p class="mt-3 text-sm leading-relaxed">Educational estimates only. Not medical or dietary advice.</p>
          </div>
          <nav aria-label="Footer">
            <ul class="flex flex-col text-sm">
              <li><a class="inline-flex min-h-[44px] min-w-[44px] items-center text-coral-soft underline underline-offset-2" href="/privacy/">Privacy</a></li>
              <li><a class="inline-flex min-h-[44px] min-w-[44px] items-center text-coral-soft underline underline-offset-2" href="/terms/">Terms</a></li>
              <li><a class="inline-flex min-h-[44px] min-w-[44px] items-center text-coral-soft underline underline-offset-2" href="/contact/">Contact</a></li>
              <li><!--email_off--><a class="inline-flex min-h-[44px] min-w-[44px] items-center text-coral-soft underline underline-offset-2" href="mailto:vetorainfo@gmail.com">vetorainfo@gmail.com</a><!--/email_off--></li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
