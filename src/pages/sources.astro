---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import EditorialLine from "../components/EditorialLine.astro";
import foodsData from "../data/foods.json";
import sourcesData from "../data/sources.json";
import { TEASPOON_GL, num } from "../lib/foods";

const { foods, categories } = foodsData;
const { sources, last_verified } = sourcesData;
const sourceById = new Map(sources.map((s) => [s.id, s]));
const categoryLabel = new Map(categories.map((c) => [c.id, c.label]));
const derivationCount = (d: string) => foods.filter((f) => f.derivation === d).length;

// Foods whose printed glycaemic load does not divide to the teaspoon figure the
// source prints, because the teaspoon figure follows from the unrounded GI x
// carbohydrate load. Selected from the data, not by id. A food that misses by
// more than 0.05 either way is only listed when the unrounded load reconciles
// it; potato-baked does not, and is covered by its own entry above.
const short = (portion: string) =>
  portion.match(/\b(\d+(?:\.\d+)?\s?(?:g|ml|kg|l))\b/i)?.[1] ??
  portion.match(/\(([^)]+)\)\s*$/)?.[1] ??
  portion;

const rounding = foods
  .filter((f) => f.gi !== null && f.carbs_g !== null && Math.abs(f.gl / TEASPOON_GL - f.cubes) > 0.05)
  .map((f) => ({ ...f, calculated: (f.gi! * f.carbs_g!) / 100 }))
  .filter((f) => Math.abs(f.calculated / TEASPOON_GL - f.cubes) <= 0.05)
  .map((f) => ({ ...f, portionShort: short(f.portion) }));
if (rounding.length === 0) throw new Error("rounding disclosure: no food disagrees any more");

// The baked potato entry below compares the printed load with the unrounded one.
const potatoFood = foods.find((f) => f.id === "potato-baked");
if (!potatoFood || potatoFood.gi === null || potatoFood.carbs_g === null)
  throw new Error("baked potato: no GI or carbohydrate");
const potato = { ...potatoFood, calculated: (potatoFood.gi * potatoFood.carbs_g) / 100 };
---

<Layout
  title="Sources and attribution: every food value and where it comes from"
  description="Provenance for every food in the sugar teaspoon calculator, attributed to Dr David Unwin and the Public Health Collaboration, with links to the research."
>
  <PageIntro
    slot="intro"
    title="Sources"
    lede="Every value in the calculator, where it was read or how it was calculated, and the people whose work it rests on."
  >
    <EditorialLine class="mt-4" />
  </PageIntro>

  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="prose-body">
      <h2 style="margin-top:0">Attribution</h2>
      <p>
        The teaspoon-of-sugar method and nearly every food value on this site are the work of <strong>Dr David Unwin</strong>,
        a general practitioner at Norwood Surgery in Southport, England, and his co-authors <strong>Dr David Haslam</strong> and
        <strong>Dr Geoffrey Livesey</strong>. The paper credits Dr Livesey with the calculations that produce the teaspoon
        equivalents.
      </p>
      <p>
        The method is published as: Unwin D, Haslam D, Livesey G. It is the glycaemic response to, not the carbohydrate
        content of food that matters in diabetes and obesity: The glycaemic index revisited. <em>Journal of Insulin
        Resistance</em>. 2016;1(1):a8. DOI:
        <a href="https://doi.org/10.4102/jir.v1i1.8">10.4102/jir.v1i1.8</a>. The journal now publishes as the Journal of
        Metabolic Health, and the article is available at
        <a href="https://journalofmetabolichealth.org/index.php/jmh/article/view/8">journalofmetabolichealth.org</a>.
      </p>
      <p>
        The sugar infographics are distributed free by the <strong>Public Health Collaboration</strong>, a UK registered
        charity, at <a href="https://phcuk.org/sugar">phcuk.org/sugar</a>, where they are also available in more than 40
        translations.
      </p>

      <h2>Licence and permission to reuse</h2>
      <p>
        This site reproduces numerical values from the infographics and the paper. It does not reproduce the infographic
        images. Written permission from the charts' distributor, a public statement by their author and the licence of a
        journal article are different things. Each is set out separately below, starting with the one the site rests on.
      </p>

      <h3>Written permission from the Public Health Collaboration</h3>
      <p>
        The operator of this site wrote to the Public Health Collaboration asking whether the values read from the sugar
        infographics could be reproduced here with attribution. On 14 September 2026, Team PHC replied in writing:
      </p>
      <blockquote>
        "Yes, we're happy for you to use the infographics on your website along with attribution to Dr Unwin and PHC."
      </blockquote>
      <p>
        The reply asks that any attribution include a link to
        <a href="https://phcuk.org/sugar">https://phcuk.org/sugar</a>. This written permission is the basis on which the
        site uses the infographic values, and it is conditional: every attribution on the site names Dr David Unwin and the
        Public Health Collaboration and links to that address. The permission covers the infographics without a limit on
        which charts. It is permission for this site only, it is not a statement about the licence of the 2016 journal
        article, and it is not an endorsement of this site.
      </p>
      <p>
        No public licence statement was found on the Public Health Collaboration's sugar page, whose footer reads ©
        Public Health Collaboration.
      </p>

      <h3>Dr Unwin's public statement, 2021</h3>
      <p>
        On 26 May 2021, Dr Unwin posted a seven-part thread on X from his account @lowcarbGP introducing the sugar
        infographics. The first post links to phcuk.org/sugar and describes the charts as "Freely available". The
        <a href="https://x.com/lowcarbGP/status/1397640332649582597">second post</a> reads, in part:
      </p>
      <blockquote>
        "The 7 sugar infographics are now available in 14 languages and no copyright, so please use freely."
      </blockquote>
      <p>
        This is a public statement by the author on social media. It is not a formal licence: it names no licence terms,
        and it is not a statement by the Public Health Collaboration, which distributes the charts, or by the journal. It
        is consistent with the written permission above and is recorded here as corroboration. The site does not rest on it.
      </p>

      <h3>The 2016 journal article</h3>
      <p>
        The Journal of Insulin Resistance (Journal of Metabolic Health) states that all its articles are published under
        the <a href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 International licence
        (CC BY 4.0)</a> unless otherwise stated. The licence field on this article's own page reads "Other", so this site
        could not confirm that the 2016 paper itself carries CC BY 4.0. The article is © 2016 David Unwin, David Haslam and
        Geoffrey Livesey. As a precaution, the values are attributed here in the form CC BY 4.0 requires: the work, its
        authors and its source are named above, and the changes made are listed below.
      </p>
      <p>
        The Public Health Collaboration's permission above concerns the infographics. It does not answer the licence
        question for the article.
      </p>
      <p>
        <strong>Changes made:</strong> values are shown to one decimal place; portion descriptions have been expanded with
        US-recognisable measures alongside the published gram weights; foods from several charts have been combined into
        one list and sorted into categories; where charts disagree, one value is used and the other is recorded below.
      </p>
      <p>
        This site is independent. It is not affiliated with, reviewed by or endorsed by Dr Unwin, his co-authors, the
        Public Health Collaboration or the journal.
      </p>

      <h2>How each value was produced</h2>
      <p>Every food carries one of three derivation labels:</p>
      <ul>
        <li>
          <strong>Read from infographic</strong> ({derivationCount("read from infographic")} foods): the teaspoon figure is
          printed on one of Dr Unwin's charts and was copied as printed.
        </li>
        <li>
          <strong>Published GL table</strong> ({derivationCount("published GL table")} foods): the teaspoon figure is
          printed in Table 1 of the 2016 paper, which also gives GI, carbohydrate and glycaemic load.
        </li>
        <li>
          <strong>Calculated from GI and carb content</strong> ({derivationCount("calculated from GI and carb content")}
          foods): chicken, salmon and beef. USDA FoodData Central lists 0.0g carbohydrate per 100g for each, so the
          glycaemic load is 0 whatever GI is assumed.
        </li>
      </ul>
      <p>
        Where a chart prints a teaspoon figure but no glycaemic load, the GL column below was back-calculated as teaspoons ×
        {TEASPOON_GL}, the glycaemic load of one teaspoon of table sugar given in the paper. Those rows say so in their notes. The
        teaspoon figure is always the published one.
      </p>
      <p>Sources last verified: {last_verified}.</p>
    </div>
  </section>

  <section class="border-y border-line bg-paper" aria-labelledby="table-heading">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <h2 id="table-heading" class="font-serif text-2xl font-medium text-ink">All {foods.length} foods</h2>
      <p class="mt-2 max-w-prose text-sm text-muted">The table scrolls sideways on narrow screens.</p>
      <div class="mt-5 overflow-x-auto rounded-md border border-line">
        <table class="min-w-[64rem] border-collapse text-left text-sm">
          <caption class="sr-only">Every food in the calculator with its portion, teaspoon figure, glycaemic load, source, derivation and notes</caption>
          <thead class="bg-sand text-ink">
            <tr>
              <th scope="col" class="px-3 py-2 font-semibold">Food</th>
              <th scope="col" class="px-3 py-2 font-semibold">Category</th>
              <th scope="col" class="px-3 py-2 font-semibold">Portion</th>
              <th scope="col" class="px-3 py-2 font-semibold">Teaspoons</th>
              <th scope="col" class="px-3 py-2 font-semibold">GL</th>
              <th scope="col" class="px-3 py-2 font-semibold">Source</th>
              <th scope="col" class="px-3 py-2 font-semibold">Derivation</th>
              <th scope="col" class="px-3 py-2 font-semibold">Notes</th>
            </tr>
          </thead>
          <tbody>
            {
              foods.map((food) => {
                const src = sourceById.get(food.source);
                return (
                  <tr class="border-t border-line align-top">
                    <th scope="row" class="px-3 py-2 font-semibold text-ink">
                      <a class="link" href={`/foods/${food.id}/`}>{food.name}</a>
                    </th>
                    <td class="px-3 py-2 text-body">{categoryLabel.get(food.category)}</td>
                    <td class="px-3 py-2 text-body">{food.portion}</td>
                    <td class="px-3 py-2 font-serif text-base text-coral">{food.cubes.toFixed(1)}</td>
                    <td class="px-3 py-2 text-body">{food.gl}</td>
                    <td class="px-3 py-2">
                      {src ? <a class="link" href={src.url}>{src.title}</a> : food.source}
                    </td>
                    <td class="px-3 py-2 text-body">{food.derivation}</td>
                    <td class="max-w-[22rem] px-3 py-2 text-body">{food.notes}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="prose-body">
      <h2 style="margin-top:0">Where the published sources disagree</h2>
      <p>
        The charts were drawn at different times from different table entries, and a few figures do not match from one
        chart to the next. None of these has been adjusted. The value used, and the other value, are recorded here.
      </p>
      <ul>
        <li>
          <strong>Banana, 120g:</strong> 5.9 on the fruits chart (used), which the sugar burden chart's 4.9 per 100g also
          gives for 120g; 5.7 on the common foods and fruits vs vegetables charts and in Figure 1 of the paper.
        </li>
        <li><strong>Apple, 120g:</strong> 2.2 on the fruits chart (used); 2.3 on the common foods chart and in Table 1 of the paper.</li>
        <li><strong>Brown or wholemeal bread, 30g slice:</strong> 3.3 on the bread chart (used); 3.0 on the common foods chart.</li>
        <li><strong>Cornflakes, 30g:</strong> 8.4 on the breakfast cereals chart (used); 8.5 in Table 1.</li>
        <li><strong>Bran flakes, 30g:</strong> both give 3.7, but the chart lists GI 74 and Table 1 lists GI 50.</li>
        <li>
          <strong>Broccoli:</strong> 0.2 for 80g on the common foods chart (used); 0.1 for 250g on the white, brown or green
          chart. The common foods chart prints GI 15; Figure 1 and the text of the paper give GI 54.
        </li>
        <li>
          <strong>Baked potato, 150g:</strong> 8.2 in Figure 1 of the paper (used), whose Box 1 load of {num(potato.gl)} divides
          to {(potato.gl / TEASPOON_GL).toFixed(1)} (the unrounded {num(potato.calculated)} gives{" "}
          {(potato.calculated / TEASPOON_GL).toFixed(1)}); 6.3 per 100g on the sugar burden chart, which would be 9.5 for 150g.
        </li>
        <li>
          <strong>Sweet corn, 80g:</strong> 4.0 on the common foods and fruits vs vegetables charts and in Table 1 (used);
          7.3 in Figure 1 of the paper.
        </li>
        <li>
          <strong>French fries, 150g:</strong> 7.5 on the common foods chart and in Table 1 (used); 5.1 per 100g on the
          sugar burden chart, which would be 7.7 for 150g.
        </li>
        <li>
          <strong>White rice, 150g:</strong> the white, brown or green chart prints a glycaemic load of 26 and 9.6 teaspoons,
          although 26 ÷ {TEASPOON_GL} is 9.5. The printed 9.6 is used.
        </li>
        <li>
          <strong>Apple juice:</strong> 4.0 for 200ml on the healthy breakfast chart (used); 4.3 per 100ml on the sugar
          burden chart, which would be 8.6 for 200ml.
        </li>
        <li>
          <strong>Bread, two slices (60g):</strong> the white, brown or green chart gives 8 (white) and 6 (brown), which are
          not exactly double the single-slice figures of 3.7 and 3.3. The calculator uses the single-slice chart.
        </li>
        {
          rounding.map((f) => (
            <li>
              <strong>
                {f.name}, {f.portionShort}:
              </strong>{" "}
              Table 1 prints a glycaemic load of {num(f.gl)}, although its own GI {f.gi} and {num(f.carbs_g!)}g of available
              carbohydrate give {f.gi} × {num(f.carbs_g!)} ÷ 100 = {num(f.calculated)}. The printed {num(f.gl)} is shown, and the
              teaspoon figure of {f.cubes.toFixed(1)} follows from the unrounded {num(f.calculated)}.
            </li>
          ))
        }
        <li>
          <strong>Cauliflower, tomato and mushrooms (Table 1):</strong> the printed glycaemic load column (0.32, 0.24,
          0.03) does not equal GI × carbohydrate ÷ 100 (1.9, 0.9, 0.2), but the printed teaspoon figures match the
          calculated loads. The teaspoon figures are used as printed, and the GL column here holds the calculated load.
        </li>
      </ul>

      <h2>Foods left out</h2>
      <p>These appear on the charts or were considered, and were not included.</p>
      <ul>
        <li>
          <strong>Couscous (Table 1):</strong> listed as 150g rehydrated with 14g of available carbohydrate and 3.3
          teaspoons. That carbohydrate figure is well below typical values for cooked couscous, and the discrepancy could
          not be resolved from the paper.
        </li>
        <li>
          <strong>Fizzy orange, skimmed milk and apple juice per 100ml (sugar burden chart):</strong> the drink figures on
          this chart are not consistent with the other charts, so none of them is used.
        </li>
        <li>
          <strong>Chocolate:</strong> the chocolate chart counts grams of sugar per bar, not glycaemic load, so its figures are
          a different measure.
        </li>
        <li>
          <strong>Beans and pulses chart:</strong> found only in translated sets. The Public Health Collaboration notes that
          translations have not been independently verified.
        </li>
        <li>
          <strong>Cheese, nuts, olive oil, spinach, salad leaves, courgette and similar:</strong> the charts list these as
          very low glycaemic foods but print no figure for them.
        </li>
        <li>
          <strong>Duplicates:</strong> foods that appear on more than one chart with the same portion are listed once.
        </li>
      </ul>
      <p>
        No foods were added from other GI tables. The Harvard Health GI and GL list sits behind a subscription wall, and the
        online appendix of the 2008 international tables could not be retrieved, so neither was used as a direct source.
      </p>

      <h2>Reference list</h2>
    </div>

    <ol class="mt-4 max-w-prose space-y-4 text-[0.95rem] leading-relaxed text-body">
      {
        sources.map((s) => (
          <li class="rounded-md border border-line bg-paper p-4">
            <p class="font-semibold text-ink">{s.title}</p>
            <p class="mt-1">{s.author}. {s.publisher}.</p>
            <p class="mt-1 break-words">
              <a class="link" href={s.url}>{s.url}</a>
            </p>
            <p class="mt-1 text-sm text-muted">Accessed {s.date_accessed}. {s.licence}</p>
            {s.publisher === "Public Health Collaboration" && (
              <p class="mt-1 text-sm text-muted">
                Attribution: Dr David Unwin and the Public Health Collaboration,{" "}
                <a class="link" href="https://phcuk.org/sugar">phcuk.org/sugar</a>.
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <div class="prose-body mt-10">
      <h2 style="margin-top:0">Reporting an error</h2>
      <p>
        If a value here does not match its source, or a better source exists, please write in through the
        <a href="/contact/">contact page</a> and include the source. Values are re-checked against the sources above twice a
        year.
      </p>
    </div>
  </section>
</Layout>
